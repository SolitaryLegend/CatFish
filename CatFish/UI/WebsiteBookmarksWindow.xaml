<Window x:Class="CatFish.UI.WebsiteBookmarksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网址收藏 · CatFish" Width="380" Height="460" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="BookmarkText" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="BookmarkUrl" TargetType="TextBlock" BasedOn="{StaticResource BookmarkText}">
            <Setter Property="Foreground" Value="#4E74A4"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style x:Key="BookmarkEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="BookmarkAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4E74A4"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="Body" Margin="4">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="BookmarksGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="26" SelectionUnit="Cell" SelectionMode="Single"
                  Background="White" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                  HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}" VerticalGridLinesBrush="{StaticResource BorderBrushSoft}" GridLinesVisibility="All">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#EDF4F1"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Padding" Value="5,0"/><Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3F4EF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger></Style.Triggers>
                </Style>
                <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/></Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Width="62" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource BookmarkText}" EditingElementStyle="{StaticResource BookmarkEditor}"/>
                <DataGridTextColumn Header="网址" Width="*" MinWidth="100" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource BookmarkUrl}" EditingElementStyle="{StaticResource BookmarkEditor}"/>
                <DataGridTextColumn Header="描述" Width="76" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    ElementStyle="{StaticResource BookmarkText}" EditingElementStyle="{StaticResource BookmarkEditor}"/>
                <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource BookmarkAction}" Click="Visit_Click" ToolTip="在默认浏览器中访问"><TextBlock Text="访问" TextDecorations="Underline"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource BookmarkAction}" Click="Delete_Click"><TextBlock Text="删除" TextDecorations="Underline"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="1" Margin="0,3,0,0" Height="14">
            <TextBlock Text="双击编辑 · 末行新增 · 自动保存" Foreground="{StaticResource MutedBrush}" FontSize="10">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="StatusText" Foreground="#A65745" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Grid>
    </Grid>
</Window>
